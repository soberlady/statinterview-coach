# LiveKit Agent worker
# Set to 1 only for the public, read-only portfolio deployment. The Worker
# redirects the landing page to /showcase and blocks every operational API.
STATINTERVIEW_PUBLIC_SHOWCASE=0

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# The web token endpoint and the Python worker must share these credentials.
# Use a unique LiveKit Cloud project for demos; never expose the secret in
# browser code.

# The public URL of the deployed StatInterview web/API service.
STATINTERVIEW_API_BASE_URL=http://localhost:3000

# Optional service-to-service access for an owner-only deployed API. The
# bearer token is injected into the worker at runtime and must remain empty in
# source control. Sites accepts it through OAI-Sites-Authorization.
STATINTERVIEW_API_AUTH_HEADER=OAI-Sites-Authorization
STATINTERVIEW_API_AUTH_BEARER_TOKEN=

# Optional LiveKit Inference model overrides.
STATINTERVIEW_STT_MODEL=deepgram/nova-3
STATINTERVIEW_STT_LANGUAGE=zh-CN
STATINTERVIEW_LLM_MODEL=google/gemma-4-31b-it
# Sonic 3.5 plus an explicit zh language avoids the provider's English default.
STATINTERVIEW_TTS_MODEL=cartesia/sonic-3.5
STATINTERVIEW_TTS_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
STATINTERVIEW_TTS_LANGUAGE=zh
STATINTERVIEW_TTS_SPEED=0.92
# Marginal LiveKit Inference list-price estimate. Supported values:
# build_ship, scale. Free credits and negotiated discounts are not deducted.
STATINTERVIEW_LIVEKIT_PRICING_PLAN=build_ship

# Console-mode fallback. In deployed rooms the id is parsed from
# a room named statinterview--<interview_id>.
STATINTERVIEW_INTERVIEW_ID=

# Optional OpenAI-compatible chat-completions endpoint for double-pass rubric
# scoring. If any value is missing or the provider fails, the app falls back
# to the transparent structure heuristic.
STATINTERVIEW_SCORER_ENDPOINT=
STATINTERVIEW_SCORER_API_KEY=
STATINTERVIEW_SCORER_MODEL=
# Optional for controlled experiments and CI. When enabled, scorer failures
# fail the request instead of entering the production fallback.
STATINTERVIEW_SCORER_STRICT=0
# Optional list-price profile for the configured scorer. Set all three values
# together; otherwise observed scorer tokens remain explicitly unpriced.
STATINTERVIEW_SCORER_INPUT_USD_PER_MILLION_TOKENS=
STATINTERVIEW_SCORER_OUTPUT_USD_PER_MILLION_TOKENS=
STATINTERVIEW_SCORER_PRICING_VERSION=
