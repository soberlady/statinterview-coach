# LiveKit Agent worker
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# The public URL of the deployed StatInterview web/API service.
STATINTERVIEW_API_BASE_URL=http://localhost:3000

# Optional LiveKit Inference model overrides.
STATINTERVIEW_STT_MODEL=deepgram/nova-3
STATINTERVIEW_LLM_MODEL=google/gemma-4-31b-it
STATINTERVIEW_TTS_MODEL=cartesia/sonic-3
STATINTERVIEW_TTS_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc

# Console-mode fallback. In deployed rooms the id is parsed from
# a room named statinterview--<interview_id>.
STATINTERVIEW_INTERVIEW_ID=
