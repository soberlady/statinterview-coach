# LiveKit Agent worker
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# The web token endpoint and the Python worker must share these credentials.
# Use a unique LiveKit Cloud project for demos; never expose the secret in
# browser code.

# The public URL of the deployed StatInterview web/API service.
STATINTERVIEW_API_BASE_URL=http://localhost:3000

# Optional LiveKit Inference model overrides.
STATINTERVIEW_STT_MODEL=deepgram/nova-3
STATINTERVIEW_LLM_MODEL=google/gemma-4-31b-it
STATINTERVIEW_TTS_MODEL=cartesia/sonic-3
STATINTERVIEW_TTS_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc

# Console-mode fallback. In deployed rooms the id is parsed from
# a room named statinterview--<interview_id>.
STATINTERVIEW_INTERVIEW_ID=

# Optional OpenAI-compatible chat-completions endpoint for double-pass rubric
# scoring. If any value is missing or the provider fails, the app falls back
# to the transparent structure heuristic.
STATINTERVIEW_SCORER_ENDPOINT=
STATINTERVIEW_SCORER_API_KEY=
STATINTERVIEW_SCORER_MODEL=
# Optional for controlled experiments and CI. When enabled, scorer failures
# fail the request instead of entering the production fallback.
STATINTERVIEW_SCORER_STRICT=0
